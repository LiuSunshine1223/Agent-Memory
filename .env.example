# DiscreteMemory 常用配置模板
# 下列值均有默认值，按本机模型和服务实际情况调整即可。

# 本地生成模型与 Ollama 服务
OLLAMA_URL=http://localhost:11434/api/generate
LLM_MODEL=llama3:8b

# BGE 模型位置；相对路径以项目根目录为基准
EMBED_MODEL_PATH=./models/bge-small-zh-v1.5

# 数据库、导入资料与两类向量索引
PRODUCT_DB_PATH=./storage/discrete_memory.db
DOCUMENTS_PATH=./storage/documents
BASE_DB_PATH=./storage/knowledge_index
MEMORY_DB_PATH=./storage/user_memory

# 可选参数（未填写时使用 config.py 中的默认值）：
# 服务监听地址和端口、模型超时、分块大小、检索条数、距离阈值与近期对话窗口。
# 需要调整时再将对应配置项加入 .env，无须复制全部默认参数。
