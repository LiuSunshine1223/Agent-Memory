# DiscreteMemory 环境配置
# 将此文件复制为项目根目录 .env，再设置服务地址、模型与存储。
# 相对本地路径以项目根目录为基准；Windows 盘符路径可映射到 WSL 挂载目录。

# Ollama 文本生成服务
OLLAMA_URL=http://localhost:11434/api/generate
LLM_MODEL=llama3:8b
LLM_TIMEOUT_SECONDS=120

# 当前本地 workspace 与产品持久数据
DEFAULT_WORKSPACE_ID=local
PRODUCT_DB_PATH=./storage/discrete_memory.db
DOCUMENTS_PATH=./storage/documents

# Web/API 监听地址
API_HOST=127.0.0.1
API_PORT=8000

# 本地 BGE 模型、知识投影与用户记忆投影
EMBED_MODEL_PATH=./models/bge-small-zh-v1.5
BASE_DB_PATH=./storage/career_knowledge
MEMORY_DB_PATH=./storage/user_memory
VECTOR_DIM=512

# 文档分块、检索条数、L2 距离上限与近期对话窗口
CHUNK_SIZE=300
OVERLAP_SENTENCE=1
BASE_RECALL_K=3
MEMORY_RECALL_K=3
BASE_MAX_DISTANCE=1.2
MEMORY_MAX_DISTANCE=1.5
SHORT_TERM_LIMIT=5
